# =============================================================================
# SHRESTHANSHI SOLAR SOLUTIONS - MONGODB ATLAS CONFIGURATION
# =============================================================================

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas (https://www.mongodb.com/cloud/atlas):
# 1. Sign in to MongoDB Atlas -> Clusters -> Click "Connect"
# 2. Choose "Drivers" (Node.js)
# 3. Replace <db_username> and <db_password> with your MongoDB user credentials.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/shresthanshi_solar?retryWrites=true&w=majority

# Optional: Database Name (defaults to 'shresthanshi_solar' if omitted)
MONGODB_DB_NAME=shresthanshi_solar
